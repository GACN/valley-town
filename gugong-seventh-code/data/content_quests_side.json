     "grants": [
      "flag:qs_w1_caravan_a",
      "trust:ashina+5"
     ],
     "hint": "他只认银子，不认官话"
    },
    {
     "id": "qs_w1_caravan_b",
     "text": "看石阶上的盐渍和货箱压出的凹痕",
     "at": {
      "kind": "anchor",
      "anchor": "wumen_out",
      "radius": 10
     },
     "requires": [
      "flag:qs_w1_caravan_a"
     ],
     "grants": [
      "flag:qs_w1_caravan_b"
     ]
    },
    {
     "id": "qs_w1_caravan_c",
     "text": "到内金水桥，比一比桥面车辙的间距",
     "at": {
      "kind": "anchor",
      "anchor": "jinshui",
      "radius": 12
     },
     "requires": [
      "flag:qs_w1_caravan_b"
     ],
     "grants": [
      "flag:caravan_halting",
      "trust:ashina+8"
     ]
    }
   ]
  },
  {
